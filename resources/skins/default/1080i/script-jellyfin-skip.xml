<?xml version="1.0" encoding="UTF-8"?>
<!-- Skip Intro/Credits OSD overlay button for Jellyfin -->
<!-- Based on service.upnext popup pattern -->
<window>
	<defaultcontrol always="true">3012</defaultcontrol>
	<onload>Dialog.Close(fullscreeninfo,true)</onload>
	<controls>
		<control type="group">
			<!-- Slide in from right, positioned bottom-right -->
			<animation type="WindowOpen" reversible="false">
				<effect type="fade" start="0" end="100" time="300" />
				<effect type="slide" start="400,0" end="0,0" time="300" tween="cubic" easing="out"/>
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="fade" start="100" end="0" time="300" />
				<effect type="slide" start="0,0" end="400,0" time="300" tween="cubic" easing="in"/>
			</animation>
			<!-- Position bottom right -->
			<left>1420</left>
			<top>707</top>
			<control type="group">
				<width>460</width>
				<height>333</height>
				<!-- Background -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>460</width>
					<height>333</height>
					<texture colordiffuse="E6000000">white.png</texture>
					<aspectratio>stretch</aspectratio>
				</control>
				<!-- Accent bar on left -->
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>4</width>
					<height>333</height>
					<texture colordiffuse="FF00A4DC">white.png</texture>
				</control>
				<!-- Segment artwork fallback: Trickplay, episode, then series art. -->
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Window.Property(segment_image)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>!String.IsEmpty(Window.Property(segment_image))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(thumb)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + !String.IsEmpty(Player.Art(thumb))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(season.landscape)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + String.IsEmpty(Player.Art(thumb)) + !String.IsEmpty(Player.Art(season.landscape))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(tvshow.landscape)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + String.IsEmpty(Player.Art(thumb)) + String.IsEmpty(Player.Art(season.landscape)) + !String.IsEmpty(Player.Art(tvshow.landscape))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(season.poster)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + String.IsEmpty(Player.Art(thumb)) + String.IsEmpty(Player.Art(season.landscape)) + String.IsEmpty(Player.Art(tvshow.landscape)) + !String.IsEmpty(Player.Art(season.poster))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(tvshow.poster)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + String.IsEmpty(Player.Art(thumb)) + String.IsEmpty(Player.Art(season.landscape)) + String.IsEmpty(Player.Art(tvshow.landscape)) + String.IsEmpty(Player.Art(season.poster)) + !String.IsEmpty(Player.Art(tvshow.poster))</visible>
				</control>
				<control type="image">
					<left>15</left>
					<top>15</top>
					<width>430</width>
					<height>242</height>
					<texture>$INFO[Player.Art(tvshow.fanart)]</texture>
					<aspectratio>keep</aspectratio>
					<visible>String.IsEmpty(Window.Property(segment_image)) + String.IsEmpty(Player.Art(thumb)) + String.IsEmpty(Player.Art(season.landscape)) + String.IsEmpty(Player.Art(tvshow.landscape)) + String.IsEmpty(Player.Art(season.poster)) + String.IsEmpty(Player.Art(tvshow.poster)) + !String.IsEmpty(Player.Art(tvshow.fanart))</visible>
				</control>
				<!-- Button group -->
				<control type="group">
					<left>15</left>
					<top>267</top>
					<control type="grouplist">
						<orientation>horizontal</orientation>
						<height>56</height>
						<itemgap>10</itemgap>
						<!-- Skip button -->
						<control type="button" id="3012">
							<label>$INFO[Window.Property(skip_label)]</label>
							<height>56</height>
							<width>310</width>
							<font>font13</font>
							<textoffsetx>20</textoffsetx>
							<textcolor>FFFFFFFF</textcolor>
							<focusedcolor>FF000000</focusedcolor>
							<shadowcolor>66000000</shadowcolor>
							<aligny>center</aligny>
							<align>center</align>
							<texturefocus colordiffuse="FF00A4DC">white.png</texturefocus>
							<texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
							<pulseonselect>no</pulseonselect>
						</control>
						<!-- Close button -->
						<control type="button" id="3013">
							<label>Close</label>
							<height>56</height>
							<width>110</width>
							<font>font13</font>
							<textoffsetx>15</textoffsetx>
							<textcolor>FFFFFFFF</textcolor>
							<focusedcolor>FF000000</focusedcolor>
							<shadowcolor>66000000</shadowcolor>
							<aligny>center</aligny>
							<align>center</align>
							<texturefocus colordiffuse="FF00A4DC">white.png</texturefocus>
							<texturenofocus colordiffuse="33FFFFFF">white.png</texturenofocus>
							<pulseonselect>no</pulseonselect>
						</control>
					</control>
				</control>
			</control>
		</control>
	</controls>
</window>
